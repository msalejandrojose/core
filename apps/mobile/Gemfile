# fastlane para los builds nativos (fastlane/Fastfile). En el Mac:
#   bundle install          (una vez)
#   bundle exec fastlane ios build profile:device
source 'https://rubygems.org'

gem 'fastlane', '~> 2.242'
# native:prepare hace `pod install` dentro de `bundle exec`: sin la gema aquí
# no encuentra `pod` aunque esté instalado en el sistema.
gem 'cocoapods', '~> 1.16'
