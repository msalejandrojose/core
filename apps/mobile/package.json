{
  "name": "@core/mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "App móvil de Core — Ionic + React PWA con build a iOS/Android vía Capacitor",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "cap:sync": "cap sync",
    "native:config": "node scripts/native-config.mjs",
    "native:prepare": "node scripts/native-prepare.mjs",
    "ota:keygen": "node scripts/ota.mjs keygen",
    "ota:publish": "node scripts/ota.mjs publish",
    "ios:prod": "CAP_SERVER_URL= VITE_API_URL=https://brio-api.ajly.online sh -c 'pnpm --filter @core/api-client generate:offline && tsc --noEmit && vite build && cap sync ios'",
    "cap:add:ios": "cap add ios",
    "ios:live-activity": "ruby scripts/ios-live-activity.rb",
    "cap:add:android": "cap add android",
    "assets:generate": "capacitor-assets generate --iconBackgroundColor '#1c1c1e' --iconBackgroundColorDark '#1c1c1e' --splashBackgroundColor '#f2f2f7' --splashBackgroundColorDark '#1c1c1e'"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-health": "^8.13.0",
    "@capgo/capacitor-social-login": "^8.7.11",
    "@capgo/capacitor-updater": "^8.54.2",
    "@core/api-client": "workspace:*",
    "@core/forms": "workspace:*",
    "@core/sections": "workspace:*",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "i18next": "^26.3.1",
    "ionicons": "^7.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "plist": "^3.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
