# Entorno de los tests E2E (`pnpm test:e2e`). Apunta a la BBDD efímera que
# levanta `docker/docker-compose.test.yml` (puerto 3307, aislada de la de
# desarrollo). Se commitea porque no contiene secretos reales: solo viven
# mientras dura el contenedor de test.

NODE_ENV=test
PORT=3002

# Silenciamos el logger estructurado para no ensuciar la salida de jest.
LOG_LEVEL=silent

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000

# BBDD efímera de test — NO compartir con dev (docker-compose.test.yml).
DB_HOST=localhost
DB_PORT=3307
DB_NAME=core_test
DB_USER=core_test
DB_PASSWORD=core_test
# Usado solo por la CLI de prisma (prisma.config.ts → `prisma migrate deploy`).
DATABASE_URL="mysql://core_test:core_test@localhost:3307/core_test"

# Secreto de test — no reutilizar en real. Inofensivo: la BBDD y el server son efímeros.
JWT_SECRET=e2e-test-secret-do-not-use-in-prod
JWT_EXPIRES_IN=60m

MAIL_FROM="Core <noreply@example.com>"
APP_URL=http://localhost:3002

STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_PATH=.storage-test
STORAGE_RAW_TOKEN_TTL_SECONDS=300
STORAGE_VIEW_TOKEN_TTL_SECONDS=3600
