// Prisma schema — https://pris.ly/d/prisma-schema
//
// Notas:
// - Generador `prisma-client` (nuevo en Prisma 7, sin Rust engine). El cliente
//   se emite a `src/generated/prisma/` para que `nest build` lo compile junto
//   con el resto del código y sobreviva al `pnpm deploy` dentro de Docker.
// - El `url` ya NO va aquí. Vive en `prisma.config.ts` (CLI) y en el
//   constructor de `PrismaClient` vía driver adapter (runtime).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Discriminador de tipo de usuario. Permite un único modelo `User` con email
/// globalmente único, evitando tablas separadas por tipo.
enum UserType {
  BACKOFFICE
  APP
}

/// Ámbito de aplicación de un rol. Guard-rail para validar en código que no
/// se asigne un rol APP a un usuario BACKOFFICE y viceversa.
enum RoleScope {
  BACKOFFICE
  APP
  SHARED
}

/// Nivel de permiso jerárquico: cada nivel implica los anteriores.
/// NONE es un bloqueo explícito que gana sobre cualquier herencia.
enum PermissionLevel {
  NONE
  READ
  WRITE
  DELETE
  ADMIN
}

/// Backend de almacenamiento físico donde vive el binario de un `StoredFile`.
enum StorageDriver {
  LOCAL
  S3
  GCS
}

/// Ciclo de vida de un `StoredFile`. `PENDING` se usa en el flujo de subida
/// directa (signed upload URL) hasta que `POST /files/:id/confirm` verifica
/// que el binario llegó al backend de storage.
enum StoredFileStatus {
  PENDING
  READY
}

/// Severidad de una entrada de `ErrorLog`. Coincide 1:1 con el tipo
/// `ErrorLevel` del catálogo de errores en `src/shared/errors/error-catalog.ts`.
enum ErrorLevel {
  info
  warn
  error
  critical
}

/// Ciclo de vida editorial de un post del blog.
enum PostStatus {
  DRAFT // borrador, no visible en el listado público
  SCHEDULED // programado: se publicará cuando publishedAt <= now()
  PUBLISHED // visible públicamente
  ARCHIVED // retirado del público sin borrarlo
}

/// Cómo se dispara un workflow.
enum WorkflowTriggerKind {
  EVENT
  CRON
  MANUAL
}

/// Estado de una instancia viva (run) de un workflow.
enum WorkflowRunStatus {
  RUNNING // hay un step en curso o listo para avanzar
  WAITING // tiene PendingActions abiertas (delay / wait_for_event)
  COMPLETED
  FAILED
  CANCELED
}

/// Estado de la ejecución de un step concreto dentro de un run.
enum WorkflowStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// Tipo de trabajo diferido que procesa el scheduler (iteración posterior).
enum PendingActionKind {
  DELAY // se consume cuando runAt <= now
  WAIT_EVENT // se consume cuando llega un Event matching
  WAIT_CONDITION // se reevalúa la condición cada runAt hasta cumplirse o vencer deadlineAt
  RETRY // reintento programado de un step que falló
  PENDING_START // un trigger se disparó pero maxConcurrentRuns está lleno
}

enum PendingActionStatus {
  PENDING
  CONSUMED
  CANCELED
}

/// Ámbito de un nodo del árbol de navegación de UI. Distinto de `RoleScope`:
/// aquí marcamos en qué app (`BACKOFFICE`/`APP`) se renderiza la sección, o si
/// es compartida (`SHARED`, p.ej. perfil/ajustes que existen en ambas).
enum SectionScope {
  BACKOFFICE
  APP
  SHARED
}

/// Tipo de override de acceso a una `Section`. `DENY` siempre gana sobre
/// `GRANT` (deny-by-default cuando no hay registro).
enum SectionAccessType {
  GRANT
  DENY
}

/// Estado de ciclo de vida de un formulario dinámico.
enum FormStatus {
  DRAFT // borrador, no se puede publicar instancias
  PUBLISHED // activo, se pueden crear instancias
  ARCHIVED // retirado, instancias existentes se cierran
}

/// Estado de una instancia/link público de formulario.
enum FormInstanceStatus {
  ACTIVE
  CLOSED
}

/// Política de respuesta de una instancia de formulario.
enum FormResponsePolicy {
  SINGLE_PER_LINK // una sola respuesta total por instancia
  SINGLE_PER_USER // una por usuario autenticado o fingerprint anónimo
  UNLIMITED // sin límite (salvo maxResponses)
}

/// Ciclo de vida de un lead (pipeline comercial). Ver spec `leads` §10.
enum LeadStatus {
  NEW // recién capturado, sin tocar
  CONTACTED // primer contacto hecho
  QUALIFIED // cumple criterio de calificación
  PROPOSAL // se le ha enviado propuesta/oferta
  WON // convertido (cierre positivo)
  LOST // cierre negativo
  UNQUALIFIED // descartado por no encajar
}

/// Origen por el que entró un lead.
enum LeadSource {
  WEB_FORM // vino de una FormInstance pública
  MANUAL // alta desde backoffice
  IMPORT // carga masiva
  API // integración externa
  REFERRAL // recomendación
  OTHER
}

/// Tipo de entrada del timeline de un lead.
enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  SCORE_CHANGE
  FORM_SUBMISSION
  EMAIL
  CALL
  MEETING
  CONVERSION
  SYSTEM
}

/// Canal físico de entrega de una notificación. Lo define el
/// `SendingAccountType`; el resto del sistema lo deriva de ahí. Espejo del
/// enum `NotificationChannel` de `@core/shared-types`.
enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  // futuro: WEBHOOK, IN_APP…
}

// ---------------------------------------------------------------------------
// Modelos
// ---------------------------------------------------------------------------

/// Tabla genérica de usuarios. Soporta cualquier tipo mediante el discriminador
/// `userType`. Si un tipo necesita campos propios, se añade una tabla
/// `<tipo>_profile` con FK a `user.id`.
model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  userType     UserType  @map("user_type")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Email verification
  emailVerificationToken     String?   @map("email_verification_token") @db.VarChar(128)
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  // Password reset
  passwordResetToken     String?   @map("password_reset_token") @db.VarChar(128)
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  // Social login (Google / Facebook). `sub` (Google) / `id` (Facebook) del
  // proveedor. Únicos y nullable: un usuario puede no tener ninguno, uno o
  // ambos vinculados (login con password + social sobre la misma cuenta).
  googleId   String? @unique @map("google_id") @db.VarChar(255)
  facebookId String? @unique @map("facebook_id") @db.VarChar(255)
  avatarUrl  String? @map("avatar_url") @db.VarChar(1024)

  // Relaciones
  userRoles                 UserUserRole[]             @relation("UserRoles")
  assignedRolesByUser       UserUserRole[]             @relation("AssignedBy")
  userApiSectionPermissions UserApiSectionPermission[]
  storedFiles               StoredFile[]
  posts                     Post[]
  sectionAccess             UserSectionAccess[]
  dashboards                Dashboard[]
  notifications             UserNotification[]
  devices                   Device[]
  lapTimes                  LapTime[]
  carArchetypes             PlayerCarArchetype[]
  carParts                  PlayerCarPart[]
  carLoadout                PlayerCarLoadout?
  grandPrixAttempts         RacingGrandPrixAttempt[]
  onlineRaces               RacingOnlineRace[]
  onlineRaceParticipations  RacingOnlineRaceParticipant[]
  friendCode                RacingFriendCode?
  friendshipsRequested      RacingFriendship[]            @relation("FriendshipRequester")
  friendshipsReceived       RacingFriendship[]            @relation("FriendshipAddressee")

  @@map("user")
}

/// Catálogo de roles con soporte de herencia entre roles mediante self-FK
/// `parentRoleId`. El campo `code` es inmutable y se usa como identificador
/// legible (p.ej. `admin`, `editor`).
model UserRole {
  id           String    @id @default(uuid()) @db.Char(36)
  code         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(255)
  description  String?   @db.Text
  scope        RoleScope
  parentRoleId String?   @map("parent_role_id") @db.Char(36)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Self-relación para herencia entre roles
  parentRole UserRole?  @relation("RoleInheritance", fields: [parentRoleId], references: [id])
  childRoles UserRole[] @relation("RoleInheritance")

  // Relaciones
  userUserRoles             UserUserRole[]
  roleApiSectionPermissions RoleApiSectionPermission[]
  sectionAccess             RoleSectionAccess[]

  @@map("user_role")
}

/// Pivot N-N entre User y UserRole. Un usuario puede tener varios roles.
/// `assignedByUserId` provee auditoría de quién asignó el rol.
model UserUserRole {
  userId           String   @map("user_id") @db.Char(36)
  userRoleId       String   @map("user_role_id") @db.Char(36)
  assignedAt       DateTime @default(now()) @map("assigned_at")
  assignedByUserId String?  @map("assigned_by_user_id") @db.Char(36)

  // Relaciones
  user       User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  userRole   UserRole @relation(fields: [userRoleId], references: [id], onDelete: Restrict)
  assignedBy User?    @relation("AssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, userRoleId])
  @@map("user_user_role")
}

/// Catálogo jerárquico de secciones de la API. Una sección puede ser un módulo
/// (`users`), una operación (`users.create`) o una agrupación lógica.
/// La jerarquía (self-FK `parentSectionId`) es la base de la herencia de permisos.
model ApiSection {
  id              String   @id @default(uuid()) @db.Char(36)
  code            String   @unique @db.VarChar(255)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  parentSectionId String?  @map("parent_section_id") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Self-relación para jerarquía de secciones
  parentSection ApiSection?  @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections ApiSection[] @relation("SectionHierarchy")

  // Relaciones
  roleApiSectionPermissions RoleApiSectionPermission[]
  userApiSectionPermissions UserApiSectionPermission[]

  @@map("api_section")
}

/// Permisos asignados a un rol sobre una sección de la API.
/// La resolución de permisos sube por `parentSectionId` y `parentRoleId`
/// (implementada en código, no aquí).
model RoleApiSectionPermission {
  userRoleId      String          @map("user_role_id") @db.Char(36)
  apiSectionId    String          @map("api_section_id") @db.Char(36)
  permissionLevel PermissionLevel @map("permission_level")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relaciones
  userRole   UserRole   @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  apiSection ApiSection @relation(fields: [apiSectionId], references: [id], onDelete: Cascade)

  @@id([userRoleId, apiSectionId])
  @@map("role_api_section_permission")
}

/// Override de permisos por usuario sobre una sección de la API.
/// Gana sobre los permisos del rol cuando existe, incluyendo el nivel NONE
/// para bloqueo explícito.
model UserApiSectionPermission {
  userId          String          @map("user_id") @db.Char(36)
  apiSectionId    String          @map("api_section_id") @db.Char(36)
  permissionLevel PermissionLevel @map("permission_level")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relaciones
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiSection ApiSection @relation(fields: [apiSectionId], references: [id], onDelete: Cascade)

  @@id([userId, apiSectionId])
  @@map("user_api_section_permission")
}

/// Metadata de un fichero subido a través del módulo storage. El binario vive
/// en disco local (dev) o en un bucket (pre/pro) según `driver`; esta tabla
/// nunca guarda el contenido, solo dónde encontrarlo (`storageKey`).
/// Borrado lógico vía `deletedAt`; el purgado físico es un job aparte.
model StoredFile {
  id           String           @id @default(uuid()) @db.Char(36)
  ownerUserId  String?          @map("owner_user_id") @db.Char(36)
  originalName String           @map("original_name") @db.VarChar(255)
  mimeType     String           @map("mime_type") @db.VarChar(127)
  sizeBytes    Int              @map("size_bytes")
  driver       StorageDriver
  status       StoredFileStatus @default(READY)
  storageKey   String           @map("storage_key") @db.VarChar(512)
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relaciones
  owner User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@map("stored_file")
}

/// Auditoría de errores capturados por `AppExceptionFilter`. Se escribe de
/// forma asíncrona (no bloquea la respuesta al cliente) para cualquier error
/// con `level` >= `warn` — los `info` no se persisten para no inflar la tabla.
/// `errorId` correlaciona la respuesta al cliente ↔ los logs de Docker ↔ esta fila.
model ErrorLog {
  id         String     @id @default(uuid()) @db.Char(36)
  errorId    String     @unique @map("error_id") @db.Char(36)
  code       String     @db.VarChar(100)
  level      ErrorLevel
  httpStatus Int        @map("http_status")
  message    String     @db.Text
  path       String?    @db.VarChar(255)
  method     String?    @db.VarChar(10)
  userId     String?    @map("user_id") @db.Char(36)
  context    Json?
  stack      String?    @db.LongText
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([code])
  @@index([level])
  @@index([createdAt])
  @@index([userId])
  @@map("error_log")
}

/// Estado de una sesión de login social iniciada desde un cliente sin SDK
/// nativo del proveedor (hoy Godot; el mismo mecanismo sirve para Apple el
/// día que se necesite — TASK-216).
enum GoogleAuthSessionStatus {
  PENDING
  READY
  FAILED
}

/// Sesión de login con Google vía navegador del sistema: la app abre
/// `authUrl` en el navegador, Google redirige al callback de la API (no a la
/// app — Godot no expone deep links sin un shim nativo), y la app hace
/// polling de esta fila hasta que deja de estar `PENDING`.
///
/// `state` viaja como parámetro `state` de OAuth y es distinto de `id`: filtrar
/// el `id` (p.ej. en un log) no basta para completar el canje sin conocer
/// también el `state`, que solo lo tienen quien inició la sesión y Google.
model GoogleAuthSession {
  id            String                  @id @default(uuid()) @db.Char(36)
  state         String                  @unique @db.VarChar(64)
  status        GoogleAuthSessionStatus @default(PENDING)
  accessToken   String?                 @map("access_token") @db.Text
  userId        String?                 @map("user_id") @db.Char(36)
  failureReason String?                 @map("failure_reason") @db.VarChar(255)
  createdAt     DateTime                @default(now()) @map("created_at")
  expiresAt     DateTime                @map("expires_at")

  @@index([expiresAt])
  @@map("google_auth_session")
}

// ---------------------------------------------------------------------------
// Blog de noticias (módulo `blog`)
// ---------------------------------------------------------------------------

/// Artículo del blog de noticias. Es la entidad central; su cuerpo vive en
/// `content` (Markdown/HTML renderizado por el front). La portada referencia
/// un `StoredFile` del módulo storage por id (FK suave, sin `@relation`).
model Post {
  id           String     @id @default(uuid()) @db.Char(36)
  slug         String     @unique @db.VarChar(180) // identificador legible para la URL pública
  title        String     @db.VarChar(200)
  excerpt      String?    @db.VarChar(320) // resumen/dek para listados y SEO
  content      String     @db.LongText // cuerpo del artículo (Markdown/HTML)
  status       PostStatus @default(DRAFT)
  publishedAt  DateTime?  @map("published_at") // fecha de publicación (o de programación)
  coverImageId String?    @map("cover_image_id") @db.Char(36) // FK suave a StoredFile (módulo storage)
  authorId     String?    @map("author_id") @db.Char(36)

  // SEO
  metaTitle       String? @map("meta_title") @db.VarChar(200)
  metaDescription String? @map("meta_description") @db.VarChar(320)

  // Métricas
  viewCount Int @default(0) @map("view_count")

  categoryId String? @map("category_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category PostCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     PostTagOnPost[]

  @@index([status, publishedAt]) // listado público ordenado por fecha
  @@index([categoryId])
  @@index([authorId])
  @@map("post")
}

/// Categoría jerárquica del blog (self-FK opcional para subcategorías).
/// Un post tiene 0..1 categoría.
model PostCategory {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(140)
  name        String   @db.VarChar(140)
  description String?  @db.Text
  parentId    String?  @map("parent_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Self-relación para subcategorías
  parent   PostCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children PostCategory[] @relation("CategoryHierarchy")

  posts Post[]

  @@map("post_category")
}

/// Etiqueta transversal del blog. Un post tiene 0..N etiquetas.
model PostTag {
  id        String   @id @default(uuid()) @db.Char(36)
  slug      String   @unique @db.VarChar(140)
  name      String   @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at")

  postTags PostTagOnPost[]

  @@map("post_tag")
}

/// Pivot N-N explícito entre Post y PostTag. Se deja explícito (en vez de la
/// N-N implícita de Prisma) para poder añadir metadatos al vínculo y controlar
/// el nombre de la tabla.
model PostTagOnPost {
  postId String @map("post_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)

  post Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  PostTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tag_on_post")
}

// ---------------------------------------------------------------------------
// Motor de eventos y workflows (módulo `workflows`)
// ---------------------------------------------------------------------------

/// Hecho ocurrido en el sistema, inmutable y auditable. Reentra al motor por
/// `RegisterEventUseCase`. `sourceUserId` es una FK suave (sin `@relation`).
model WorkflowEvent {
  id             String   @id @default(uuid()) @db.Char(36)
  type           String   @db.VarChar(120) // "user.signed_up"
  payload        Json
  sourceUserId   String?  @map("source_user_id") @db.Char(36)
  correlationId  String?  @map("correlation_id") @db.Char(36)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(120)
  occurredAt     DateTime @default(now()) @map("occurred_at")

  triggeredRuns WorkflowRun[]   @relation("WorkflowRunTrigger")
  consumedBy    PendingAction[] @relation("PendingActionConsumedEvent")

  @@unique([idempotencyKey]) // sparse: NULL permitido
  @@index([type, occurredAt])
  @@index([sourceUserId])
  @@index([correlationId])
  @@map("workflow_event")
}

/// Blueprint de un workflow + su DSL (JSON). Identificado por `key` + `version`.
/// Una sola versión activa por `key`.
model WorkflowDefinition {
  id          String    @id @default(uuid()) @db.Char(36)
  key         String    @db.VarChar(120)
  version     Int
  name        String    @db.VarChar(200)
  description String?   @db.Text
  dsl         Json // ver spec §4
  isActive    Boolean   @default(false) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  triggers       WorkflowTrigger[]
  runs           WorkflowRun[]
  pendingActions PendingAction[]

  @@unique([key, version])
  @@index([key, isActive])
  @@map("workflow_definition")
}

/// Cómo se dispara una definición: por evento, cron o manual.
model WorkflowTrigger {
  id           String              @id @default(uuid()) @db.Char(36)
  definitionId String              @map("definition_id") @db.Char(36)
  kind         WorkflowTriggerKind

  // kind = EVENT
  eventType       String? @map("event_type") @db.VarChar(120)
  matchExpression Json?   @map("match_expression") // mini DSL spec §4.3

  // kind = CRON
  cronExpression String?   @map("cron_expression") @db.VarChar(60) // 5 campos UTC
  cronPayload    Json?     @map("cron_payload")
  nextFireAt     DateTime? @map("next_fire_at")

  // Target (fan-out): sobre qué entidades corre. NULL = un único run global.
  target Json? // { type, filter? } — mini DSL spec §4.4

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([kind, eventType])
  @@index([kind, nextFireAt])
  @@index([definitionId])
  @@map("workflow_trigger")
}

/// Instancia viva de un workflow, con estado, contexto y cursor de step.
/// Todo el estado vive aquí para sobrevivir a reinicios.
model WorkflowRun {
  id             String            @id @default(uuid()) @db.Char(36)
  definitionId   String            @map("definition_id") @db.Char(36) // congelado (versión incluida)
  triggerEventId String?           @map("trigger_event_id") @db.Char(36)
  status         WorkflowRunStatus @default(RUNNING)
  context        Json              @default("{}")
  currentStepKey String?           @map("current_step_key") @db.VarChar(120)
  isDryRun       Boolean           @default(false) @map("is_dry_run")
  startedAt      DateTime          @default(now()) @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  lastError      String?           @map("last_error") @db.Text

  // Lock optimista del worker (iteración posterior):
  lockedBy    String?   @map("locked_by") @db.VarChar(80)
  lockedUntil DateTime? @map("locked_until")

  definition     WorkflowDefinition      @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  triggerEvent   WorkflowEvent?          @relation("WorkflowRunTrigger", fields: [triggerEventId], references: [id])
  steps          WorkflowStepExecution[]
  pendingActions PendingAction[]

  @@index([status])
  @@index([definitionId, status])
  @@index([lockedUntil])
  @@map("workflow_run")
}

/// Registro auditado de un step ejecutado dentro de un run.
model WorkflowStepExecution {
  id         String             @id @default(uuid()) @db.Char(36)
  runId      String             @map("run_id") @db.Char(36)
  stepKey    String             @map("step_key") @db.VarChar(120)
  actionKey  String             @map("action_key") @db.VarChar(120)
  status     WorkflowStepStatus @default(PENDING)
  attempt    Int                @default(1)
  input      Json?
  output     Json?
  error      String?            @db.Text
  startedAt  DateTime           @default(now()) @map("started_at")
  finishedAt DateTime?          @map("finished_at")

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, startedAt])
  @@map("workflow_step_execution")
}

/// Trabajo diferido (delay / wait_for_event / retry / arranque encolado). Lo
/// procesa el scheduler (iteración posterior). Se modela ya para no migrar luego.
model PendingAction {
  id              String              @id @default(uuid()) @db.Char(36)
  runId           String?             @map("run_id") @db.Char(36) // NULL si kind = PENDING_START
  definitionId    String?             @map("definition_id") @db.Char(36) // SET si kind = PENDING_START
  triggerEventId  String?             @map("trigger_event_id") @db.Char(36)
  stepKey         String?             @map("step_key") @db.VarChar(120)
  kind            PendingActionKind
  status          PendingActionStatus @default(PENDING)
  runAt           DateTime?           @map("run_at")
  // Fecha límite del wait (WAIT_CONDITION/WAIT_EVENT): al vencer se toma onTimeout.
  deadlineAt      DateTime?           @map("deadline_at")
  eventType       String?             @map("event_type") @db.VarChar(120)
  matchExpression Json?               @map("match_expression")
  // Entidad target ya resuelta (fan-out) para kind = PENDING_START, de modo que
  // el consumidor reanude el run sobre ESA entidad. NULL = run sin target.
  target          Json?
  consumedEventId String?             @map("consumed_event_id") @db.Char(36)
  createdAt       DateTime            @default(now()) @map("created_at")
  consumedAt      DateTime?           @map("consumed_at")

  run           WorkflowRun?        @relation(fields: [runId], references: [id], onDelete: Cascade)
  definition    WorkflowDefinition? @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  consumedEvent WorkflowEvent?      @relation("PendingActionConsumedEvent", fields: [consumedEventId], references: [id])

  @@index([status, runAt])
  @@index([status, eventType])
  @@index([status, kind, definitionId, createdAt])
  @@index([runId])
  @@map("workflow_pending_action")
}

/// Nodo del árbol de navegación de UI. `code` es el slug legible
/// (`users`, `iam.users`, `settings.general`). Self-FK `parentId` modela el
/// árbol. `apiRequirements` es la lista de códigos de `ApiSection` que el
/// usuario debe poder consumir para que la sección aparezca — sólo es una
/// conveniencia (la seguridad real la hace el guard de cada endpoint).
model Section {
  id              String       @id @default(uuid()) @db.Char(36)
  code            String       @db.VarChar(255)
  name            String       @db.VarChar(255)
  icon            String?      @db.VarChar(100)
  route           String?      @db.VarChar(500)
  parentId        String?      @map("parent_id") @db.Char(36)
  scope           SectionScope
  order           Int          @default(0)
  isActive        Boolean      @default(true) @map("is_active")
  apiRequirements Json?        @map("api_requirements")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  parent     Section?            @relation("SectionTree", fields: [parentId], references: [id])
  children   Section[]           @relation("SectionTree")
  roleAccess RoleSectionAccess[]
  userAccess UserSectionAccess[]

  @@unique([code, scope])
  @@index([scope, isActive, order])
  @@index([parentId])
  @@map("section")
}

/// Override de visibilidad de una `Section` para un rol. Si una sección tiene
/// `DENY` en algún rol del usuario, no se muestra. `GRANT` la hace visible
/// salvo que otro registro la deniegue. Sin registros → sección oculta.
model RoleSectionAccess {
  userRoleId String            @map("user_role_id") @db.Char(36)
  sectionId  String            @map("section_id") @db.Char(36)
  access     SectionAccessType
  createdAt  DateTime          @default(now()) @map("created_at")

  userRole UserRole @relation(fields: [userRoleId], references: [id], onDelete: Cascade)
  section  Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userRoleId, sectionId])
  @@index([sectionId])
  @@map("role_section_access")
}

/// Override de visibilidad de una `Section` para un usuario concreto. Tiene
/// prioridad sobre los registros de rol — útil para excepciones puntuales.
model UserSectionAccess {
  userId    String            @map("user_id") @db.Char(36)
  sectionId String            @map("section_id") @db.Char(36)
  access    SectionAccessType
  createdAt DateTime          @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([userId, sectionId])
  @@index([sectionId])
  @@map("user_section_access")
}

// ---------------------------------------------------------------------------
// Formularios dinámicos (módulo `dynamic-forms`)
// ---------------------------------------------------------------------------

/// Definición de un formulario dinámico. El `schema` es JSON que describe
/// los campos (tipo, validaciones, condiciones). Se almacena como JSON para
/// ser consumido por el renderer del frontend sin acoplamiento al backend.
model Form {
  id          String     @id @default(uuid()) @db.Char(36)
  title       String     @db.VarChar(200)
  description String?    @db.Text
  schema      Json // estructura declarativa de campos (ver TASK-92 §schema)
  status      FormStatus @default(DRAFT)
  createdById String?    @map("created_by_id") @db.Char(36) // FK suave a User
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  instances FormInstance[]

  @@index([status])
  @@index([createdById])
  @@map("form")
}

/// Link público de un formulario. Cada instancia tiene un `hash` opaco que
/// se incluye en la URL y permite configurar política, ventana y límites
/// de forma independiente para cada distribución del mismo formulario.
model FormInstance {
  id             String             @id @default(uuid()) @db.Char(36)
  formId         String             @map("form_id") @db.Char(36)
  hash           String             @unique @db.VarChar(64) // token URL-safe, ≥32 chars
  responsePolicy FormResponsePolicy @default(UNLIMITED) @map("response_policy")
  requiresAuth   Boolean            @default(false) @map("requires_auth")
  opensAt        DateTime?          @map("opens_at")
  closesAt       DateTime?          @map("closes_at")
  maxResponses   Int?               @map("max_responses") // cap global, null = sin límite
  status         FormInstanceStatus @default(ACTIVE)
  createdById    String?            @map("created_by_id") @db.Char(36) // FK suave a User
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  form      Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@index([formId])
  @@index([hash])
  @@index([status, closesAt])
  @@map("form_instance")
}

/// Respuesta enviada por un usuario (o anónimo) a una instancia de formulario.
/// `answers` guarda el mapa fieldKey→value validado. `schemaSnapshot` preserva
/// el schema vigente en el momento del envío para mantener coherencia si el
/// formulario cambia después.
model FormResponse {
  id                     String   @id @default(uuid()) @db.Char(36)
  formInstanceId         String   @map("form_instance_id") @db.Char(36)
  submittedById          String?  @map("submitted_by_id") @db.Char(36) // null si anónimo
  submittedByFingerprint String?  @map("submitted_by_fingerprint") @db.VarChar(128) // hash IP+UA para anónimos
  answers                Json // mapa fieldKey → value
  schemaSnapshot         Json     @map("schema_snapshot") // copia del schema al enviar
  submittedAt            DateTime @default(now()) @map("submitted_at")
  ipAddress              String?  @map("ip_address") @db.VarChar(45)
  userAgent              String?  @map("user_agent") @db.VarChar(512)

  formInstance FormInstance @relation(fields: [formInstanceId], references: [id], onDelete: Cascade)

  @@index([formInstanceId, submittedAt])
  @@index([submittedById])
  @@map("form_response")
}

enum WidgetType {
  KPI_CARD
  LINE
  BAR
  AREA
  GAUGE
}

/// Dashboard personalizado por usuario. Cada usuario tiene al menos uno
/// marcado como default. Los widgets definen el layout (grid react-grid-layout).
model Dashboard {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Char(36)
  name      String   @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets DashboardWidget[]

  @@index([userId])
  @@map("dashboard")
}

/// Widget dentro de un dashboard. La posición y tamaño siguen el sistema de
/// react-grid-layout (columnas x, fila y, ancho w, alto h). `config` es JSON
/// libre para customización futura (título, color, rango).
model DashboardWidget {
  id          String     @id @default(cuid())
  dashboardId String     @map("dashboard_id")
  kpiSlug     String     @map("kpi_slug") @db.VarChar(100)
  widgetType  WidgetType @map("widget_type")
  x           Int
  y           Int
  w           Int
  h           Int
  config      Json?
  order       Int        @default(0)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_widget")
}

// ---------------------------------------------------------------------------
// Leads (módulo `leads`)
// ---------------------------------------------------------------------------

/// Contacto comercial potencial y su estado en el pipeline. Las FK a `User` y a
/// `FormResponse` son suaves (columna sin `@relation`) para no acoplar el módulo
/// ni romper el histórico al borrar un usuario. Ver spec `leads`.
model Lead {
  id String @id @default(uuid()) @db.Char(36)

  // Identidad del contacto
  email           String? @db.VarChar(255)
  emailNormalized String? @map("email_normalized") @db.VarChar(255) // lower+trim para dedupe
  phone           String? @db.VarChar(40)
  firstName       String? @map("first_name") @db.VarChar(100)
  lastName        String? @map("last_name") @db.VarChar(100)
  company         String? @db.VarChar(160)

  // Ciclo de vida
  status  LeadStatus @default(NEW)
  score   Int        @default(0)
  ownerId String?    @map("owner_id") @db.Char(36) // FK suave a User

  // Atribución / origen
  source         LeadSource @default(OTHER)
  formResponseId String?    @map("form_response_id") @db.Char(36) // FK suave a FormResponse
  utmSource      String?    @map("utm_source") @db.VarChar(120)
  utmMedium      String?    @map("utm_medium") @db.VarChar(120)
  utmCampaign    String?    @map("utm_campaign") @db.VarChar(120)

  // Datos flexibles
  customFields Json? @map("custom_fields")

  // Consentimiento (GDPR)
  consentGiven Boolean   @default(false) @map("consent_given")
  consentAt    DateTime? @map("consent_at")

  // Conversión
  convertedToUserId String?   @map("converted_to_user_id") @db.Char(36) // FK suave a User
  convertedAt       DateTime? @map("converted_at")

  createdById String?  @map("created_by_id") @db.Char(36) // FK suave a User
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activities LeadActivity[]
  tags       LeadTagOnLead[]

  @@index([status, createdAt])
  @@index([ownerId, status])
  @@index([emailNormalized])
  @@index([source])
  @@map("lead")
}

/// Entrada de timeline de un lead. Inmutable: solo se añade, nunca se edita.
model LeadActivity {
  id      String           @id @default(uuid()) @db.Char(36)
  leadId  String           @map("lead_id") @db.Char(36)
  type    LeadActivityType
  body    String?          @db.Text
  meta    Json?
  actorId String?          @map("actor_id") @db.Char(36) // FK suave a User (null = sistema)

  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activity")
}

/// Catálogo de etiquetas de leads.
model LeadTag {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(80)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  leads LeadTagOnLead[]

  @@map("lead_tag")
}

/// Join N:N entre leads y etiquetas.
model LeadTagOnLead {
  leadId String @map("lead_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tag_on_lead")
}

// ---------------------------------------------------------------------------
// Notificaciones (cuentas de envío + tipos de mensaje)
// ---------------------------------------------------------------------------

/// Tipo de cuenta de envío. Define un `channel` y dos contratos declarativos:
/// `configSchema` (qué campos necesita configurar una `SendingAccount` de este
/// tipo: credenciales, remitente…) y `messageSchema` (qué campos de contenido
/// pide un `MessageType` de este canal). Son descriptores de campos (misma
/// idea que el schema de los formularios dinámicos) que dirigen el render del
/// backoffice; la validación server-side usa el catálogo de canales en código.
/// Mayormente semilla/administración.
model SendingAccountType {
  id            String              @id @default(uuid()) @db.Char(36)
  key           String              @unique @db.VarChar(60) // "email", "sms", "push"
  name          String              @db.VarChar(120)
  channel       NotificationChannel
  configSchema  Json                @map("config_schema") // descriptores de config de la cuenta
  messageSchema Json                @map("message_schema") // descriptores del contenido del mensaje
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  accounts SendingAccount[]

  @@index([channel])
  @@map("sending_account_type")
}

/// Cuenta de envío concreta y configurada de un tipo. Ej: "Resend — producción".
/// `config` se valida contra el catálogo del canal; los campos marcados como
/// secretos (apiKey, authToken…) se guardan cifrados en reposo.
model SendingAccount {
  id        String   @id @default(uuid()) @db.Char(36)
  typeId    String   @map("type_id") @db.Char(36)
  name      String   @db.VarChar(160)
  config    Json // validado contra el catálogo del tipo; secretos cifrados
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  type         SendingAccountType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  messageTypes MessageType[]

  @@index([typeId])
  @@map("sending_account")
}

/// Tipo de mensaje. Selecciona una `SendingAccount` (⇒ hereda su canal) y
/// guarda en `content` los campos propios de ese canal (subject/html para
/// email, body para SMS, title/body para push). Admite plantillas `{{ var }}`
/// que se renderizan en el momento del envío contra el contexto del workflow.
model MessageType {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(120) // "welcome_email"
  name      String   @db.VarChar(160)
  accountId String   @map("account_id") @db.Char(36)
  content   Json // validado contra el messageSchema del canal; admite plantillas
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account SendingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("message_type")
}

/// Registro de un envío concreto (una fila por dispatch real, no dry-run ni
/// skip). Sirve como log de entregabilidad: se crea al despachar y se va
/// actualizando con los eventos del proveedor (webhook de SendGrid:
/// delivered/bounce/open/click/spamreport…). No lleva FKs a message_type /
/// sending_account a propósito: es un log que debe sobrevivir a su borrado.
model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Char(36)
  messageTypeId     String?             @map("message_type_id") @db.Char(36)
  messageTypeKey    String              @map("message_type_key") @db.VarChar(120)
  accountId         String?             @map("account_id") @db.Char(36)
  channel           NotificationChannel
  provider          String              @db.VarChar(60)
  toAddress         String              @map("to_address") @db.VarChar(320)
  subject           String?             @db.VarChar(500)
  status            String              @db.VarChar(40) // pending, sent, delivered, bounced…
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255) // correlación con el webhook
  error             String?             @db.Text
  events            Json? // histórico [{ type, at, reason? }]
  sentAt            DateTime?           @map("sent_at")
  deliveredAt       DateTime?           @map("delivered_at")
  lastEventAt       DateTime?           @map("last_event_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([messageTypeKey])
  @@index([providerMessageId])
  @@index([status])
  @@index([toAddress])
  @@index([channel])
  @@index([createdAt])
  @@map("notification_delivery")
}

/// Registro crudo de cada evento entrante por webhook (SendGrid hoy; Meta/
/// WhatsApp en el futuro), independiente de si se pudo procesar o no. Permite
/// inspeccionar el payload tal cual llegó y reprocesarlo.
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Char(36)
  source         String    @db.VarChar(60) // 'sendgrid', futuro 'whatsapp'…
  type           String?   @db.VarChar(120) // tipo del evento si es identificable
  payload        Json // body crudo tal cual llegó
  signatureValid Boolean   @map("signature_valid")
  status         String    @db.VarChar(20) // pending, processed, failed
  result         String?   @db.VarChar(500)
  error          String?   @db.Text
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([source])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_event")
}

// ---------------------------------------------------------------------------
// WhatsApp — bandeja de conversaciones en tiempo real (módulo `whatsapp`)
// ---------------------------------------------------------------------------
// Bandeja de chats de WhatsApp sobre la Cloud API de Meta. El envío saliente
// reutiliza el `WhatsappChannelDispatcher` del módulo `notifications`; aquí se
// persiste la conversación bidireccional (entrantes vía webhook + salientes) y
// se emite en tiempo real al backoffice por WebSocket.
//
// `account_id` referencia una `SendingAccount` de canal WHATSAPP (su config
// tiene el `phoneNumberId` del número de negocio y el `accessToken`). No se
// modela como FK a propósito, igual que `notification_delivery`: la bandeja es
// un registro de mensajería que debe sobrevivir al borrado de la cuenta.

/// Dirección de un mensaje de WhatsApp respecto al número de negocio.
enum WhatsappMessageDirection {
  INBOUND // del cliente hacia nosotros
  OUTBOUND // de nosotros hacia el cliente
}

/// Conversación (hilo) entre un número de negocio (`account_id`) y un contacto
/// (`contact_phone`, en formato E.164 sin '+'). Única por (cuenta, contacto).
model WhatsappConversation {
  id                 String                   @id @default(uuid()) @db.Char(36)
  accountId          String                   @map("account_id") @db.Char(36)
  contactPhone       String                   @map("contact_phone") @db.VarChar(32)
  contactName        String?                  @map("contact_name") @db.VarChar(160)
  lastMessageAt      DateTime                 @default(now()) @map("last_message_at")
  lastMessagePreview String?                  @map("last_message_preview") @db.VarChar(500)
  lastDirection      WhatsappMessageDirection @default(INBOUND) @map("last_direction")
  unreadCount        Int                      @default(0) @map("unread_count")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  messages WhatsappMessage[]

  @@unique([accountId, contactPhone])
  @@index([accountId, lastMessageAt])
  @@map("whatsapp_conversation")
}

/// Mensaje individual dentro de una conversación. `wa_message_id` es el `wamid`
/// de Meta; es único para hacer idempotente la ingesta del webhook (Meta puede
/// reintentar). `status` sigue el ciclo received/sent/delivered/read/failed.
model WhatsappMessage {
  id             String                   @id @default(uuid()) @db.Char(36)
  conversationId String                   @map("conversation_id") @db.Char(36)
  direction      WhatsappMessageDirection
  waMessageId    String?                  @unique @map("wa_message_id") @db.VarChar(255)
  body           String                   @db.Text
  status         String                   @db.VarChar(40)
  timestamp      DateTime
  createdAt      DateTime                 @default(now()) @map("created_at")

  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@map("whatsapp_message")
}

// ---------------------------------------------------------------------------
// Localización / Geografía (módulo `geo`)
// ---------------------------------------------------------------------------
// Jerarquía administrativa descendente, modelada como 1-N:
//
//   Country → Region (Comunidad Autónoma) → Province → Municipality → PostalCode
//
// Los códigos oficiales (ISO 3166 para países, INE para el desglose de España)
// se guardan como claves naturales junto al uuid interno. Cada nivel referencia
// a su padre por FK; el borrado cascadea hacia abajo (borrar un país arrastra
// sus comunidades, provincias, municipios y códigos postales).
//
// Nota sobre `PostalCode`: en la realidad un CP puede solapar varios municipios
// y un municipio tiene varios CPs (relación N-M). Aquí se simplifica a 1-N (un
// CP pertenece a un municipio), que cubre el caso de uso de la app. Si en el
// futuro se necesita el solape real, se introduce una tabla puente
// `postal_code_municipality` sin tocar el resto de la jerarquía.

/// País. Clave natural: códigos ISO 3166-1 (alpha-2 / alpha-3).
model Country {
  id          String   @id @default(uuid()) @db.Char(36)
  iso2        String   @unique @db.Char(2) // ISO 3166-1 alpha-2 ("ES")
  iso3        String   @unique @db.Char(3) // ISO 3166-1 alpha-3 ("ESP")
  numericCode String?  @map("numeric_code") @db.Char(3) // ISO 3166-1 numeric ("724")
  name        String   @db.VarChar(120)
  nativeName  String?  @map("native_name") @db.VarChar(120)
  phoneCode   String?  @map("phone_code") @db.VarChar(8) // prefijo telefónico ("+34")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  regions   Region[]
  provinces Province[]

  @@index([name])
  @@map("country")
}

/// Comunidad Autónoma (nivel superior del desglose de España). Código INE de
/// 2 dígitos ("13" = Madrid), único dentro de cada país.
model Region {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @db.VarChar(10) // código INE de CCAA ("13")
  name      String   @db.VarChar(120)
  countryId String   @map("country_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  provinces Province[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([name])
  @@map("region")
}

/// Provincia. Código INE de 2 dígitos ("28" = Madrid), único dentro del país.
/// `regionId` es opcional para admitir países sin desglose de comunidades.
model Province {
  id        String   @id @default(uuid()) @db.Char(36)
  code      String   @db.VarChar(10) // código INE de provincia ("28")
  name      String   @db.VarChar(120)
  countryId String   @map("country_id") @db.Char(36)
  regionId  String?  @map("region_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country        Country        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region         Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  municipalities Municipality[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([regionId])
  @@index([name])
  @@map("province")
}

/// Municipio. Código INE de 5 dígitos ("28079" = Madrid capital), único dentro
/// de su provincia.
model Municipality {
  id         String   @id @default(uuid()) @db.Char(36)
  code       String   @db.VarChar(10) // código INE de municipio ("28079")
  name       String   @db.VarChar(160)
  provinceId String   @map("province_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  province    Province     @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  postalCodes PostalCode[]

  @@unique([provinceId, code])
  @@index([provinceId])
  @@index([name])
  @@map("municipality")
}

/// Código postal. Cinco dígitos ("28001"), único dentro de su municipio.
model PostalCode {
  id             String   @id @default(uuid()) @db.Char(36)
  code           String   @db.VarChar(10) // 5 dígitos ("28001")
  municipalityId String   @map("municipality_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@unique([municipalityId, code])
  @@index([municipalityId])
  @@index([code])
  @@map("postal_code")
}

// ---------------------------------------------------------------------------
// Notificaciones in-app (inbox por usuario)
// ---------------------------------------------------------------------------

/// Notificación in-app dirigida a un usuario. Alimenta el feed de la app
/// (`GET /me/notifications`). La escriben las acciones de workflow vía el
/// handler `notify.inApp`, pero también puede escribirla cualquier módulo de
/// dominio. `readAt` null ⇒ no leída. `data` es un payload libre para
/// deep-links / metadatos de render en el cliente.
model UserNotification {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @map("user_id") @db.Char(36)

  kind  String  @default("system") @db.VarChar(60) // 'system' | 'workflow' | ...
  title String  @db.VarChar(200)
  body  String? @db.Text
  data  Json?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notification")
}

/// Token de push de un dispositivo de un usuario (FCM). Un usuario puede tener
/// varios dispositivos; el `token` es único globalmente (lo emite el proveedor).
/// Al re-registrarse el mismo token se hace upsert y se refresca `lastSeenAt`
/// (y se reasigna el `userId` si el dispositivo cambió de cuenta). Al hacer
/// logout la app lo da de baja con `DELETE /me/devices/:token`.
model Device {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  token      String   @unique @db.VarChar(512)
  platform   String   @db.VarChar(20) // 'ios' | 'android' | 'web'
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device")
}

// ---------------------------------------------------------------------------
// Racing
// ---------------------------------------------------------------------------

/// Ambientación de un circuito: de qué textura de paleta sale, replica de
/// `TrackTheme.Kind` en `apps/game/scripts/track/track_theme.gd`.
enum TrackTheme {
  MEADOW
  SNOW
}

/// Circuito jugable.
///
/// Cada SENTIDO es una fila distinta ("kenney-01" y "kenney-01-rev"): una
/// vuelta al revés no es comparable con una normal, así que son leaderboards
/// separados. Modelarlo como `Track` hace que la separación sea estructural,
/// en vez de depender de que cada consulta se acuerde de filtrar por sentido.
///
/// La geometría (`path`, `theme`, `grip`) es la misma fila que ancla los
/// tiempos: antes solo vivía en el catálogo del cliente
/// (`apps/game/scripts/track/track_catalog.gd`), pero un circuito nacido en
/// el servidor (backoffice) no tiene catálogo de cliente del que partir.
model Track {
  id   String @id @default(uuid()) @db.Char(36)
  /// Coincide con el id del catálogo del cliente, con sufijo "-rev" en inverso.
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(120)

  /// Nº de SECTORES de la vuelta = checkpoints intermedios + la meta. Es
  /// también la longitud que debe tener `splitsMs`. En el cliente es
  /// `LapTimer.sector_count()`.
  sectorCount Int @map("sector_count")

  /// Suelo de plausibilidad, en ms. Nadie da una vuelta más rápida que esto,
  /// así que un tiempo por debajo se rechaza sin más análisis. Es la validación
  /// más barata que existe contra el manipulador casual.
  minPlausibleMs Int @map("min_plausible_ms")

  /// Celdas del trazado en orden de recorrido HACIA ADELANTE, como
  /// `TrackCatalog.Layout.path`: `[{"x":0,"y":0},{"x":0,"y":1},...]`. El
  /// sentido inverso reutiliza esta misma lista — es la misma pista recorrida
  /// al revés, no otra geometría — así que no se duplica aquí.
  path Json

  /// Tema visual del circuito entero. Cuando el terreno de sección avance
  /// (TASK-271), esto pasa a ser el valor por defecto de las celdas que no
  /// tengan un terreno propio pintado encima, no se sustituye por ello.
  theme TrackTheme @default(MEADOW)

  /// Agarre de la superficie: 1.0 asfalto seco. Por debajo, el coche tarda más
  /// en girar, en acelerar y sobre todo en frenar. Mismo eje que
  /// `TrackCatalog.Layout.grip` y `Vehicle.grip` en el cliente.
  grip Float @default(1.0)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lapTimes              LapTime[]
  grandPrixStages       RacingGrandPrixStage[]
  grandPrixStageResults RacingGrandPrixStageResult[]
  onlineRaces           RacingOnlineRace[]

  @@index([isActive])
  @@map("racing_track")
}

/// Un intento de vuelta subido por un jugador.
///
/// Se guardan TODOS los intentos, no solo el mejor: el histórico es la materia
/// prima de los KPIs y de cualquier detección de trampas posterior. El mejor
/// tiempo se calcula consultando, no guardando estado aparte que pueda
/// desincronizarse.
model LapTime {
  id      String @id @default(uuid()) @db.Char(36)
  userId  String @map("user_id") @db.Char(36)
  trackId String @map("track_id") @db.Char(36)

  /// Tiempo total en milisegundos. Entero: un tiempo se compara y se ordena, y
  /// con floats dos vueltas idénticas dejan de serlo.
  durationMs Int @map("duration_ms")

  /// Splits acumulados por sector, en ms. JSON porque el nº varía por circuito.
  /// Monótono creciente y con el último igual a `durationMs`.
  splitsMs Json @map("splits_ms")

  /// Versión del build que generó el tiempo. Cualquier cambio en la física
  /// invalida la comparabilidad con los tiempos anteriores; sin este campo, el
  /// primer ajuste de manejo obliga a borrar el leaderboard entero o a vivir
  /// con datos mentirosos.
  clientVersion String @map("client_version") @db.VarChar(32)

  /// Anulado desde el backoffice (TASK-239/242) sin borrar la fila, para que
  /// quede constancia. Nulo = válido. Un tiempo anulado no cuenta para el
  /// leaderboard, la posición ni la mejor marca personal.
  invalidatedAt DateTime? @map("invalidated_at")

  /// Instantáneas de posición/rotación de la vuelta, para reproducirla como
  /// fantasma (TASK-219/220/221). Solo se guarda si esta fila es la mejor
  /// marca del jugador en el circuito — el resto de intentos no lo
  /// necesitan, y guardarlo en todos multiplicaría el almacenamiento sin
  /// uso claro. Formato: snapshots a ~20 Hz, decisión de partida de
  /// TASK-219.
  ghostSnapshots Json? @map("ghost_snapshots")

  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  /// El leaderboard consulta por circuito ordenando por tiempo.
  @@index([trackId, durationMs])
  /// Y la mejor marca propia, por circuito y usuario.
  @@index([userId, trackId, durationMs])
  /// El rate limit del anti-cheat mira el último intento de cada usuario.
  @@index([userId, createdAt])
  @@map("racing_lap_time")
}

/// Hueco de equipamiento de una `CarPart`. Un jugador lleva como mucho una
/// pieza por categoría a la vez (TASK-263): no tiene sentido llevar dos
/// juegos de neumáticos montados.
enum CarPartCategory {
  TIRES
  WING
  CHASSIS
}

/// Catálogo de arquetipos de coche (TASK-262): normal/F1/4x4, cada uno con su
/// propio perfil de partida sobre los mismos ejes que ya usa `Vehicle` en el
/// cliente — `speedScale` (velocidad punta) y `grip` (agarre en asfalto seco).
///
/// `offroadGripModifier` es el eje que decide TASK-264: multiplica el grip
/// efectivo del circuito/celda cuando la superficie NO es asfalto seco (tema
/// `SNOW`, o una celda con terreno de sección pintado). En asfalto seco no se
/// aplica ningún ajuste.
model CarArchetype {
  id   String @id @default(uuid()) @db.Char(36)
  /// Identificador estable, independiente del nombre visible.
  code String @unique @db.VarChar(64)
  name String @db.VarChar(120)

  speedScale          Float @map("speed_scale")
  grip                Float
  offroadGripModifier Float @map("offroad_grip_modifier")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  playerOwnerships PlayerCarArchetype[]
  loadouts         PlayerCarLoadout[]

  @@index([isActive])
  @@map("racing_car_archetype")
}

/// Catálogo de piezas montables (TASK-263). Independientes del arquetipo:
/// una misma pieza vale para cualquier arquetipo. Los efectos son DELTAS que
/// se suman al perfil base del arquetipo equipado, no valores absolutos —
/// ver `computeCarStats` en el dominio.
model CarPart {
  id       String          @id @default(uuid()) @db.Char(36)
  code     String          @unique @db.VarChar(64)
  category CarPartCategory
  name     String          @db.VarChar(120)

  speedScale Float @map("speed_scale")
  grip       Float

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  playerOwnerships PlayerCarPart[]
  loadoutTires     PlayerCarLoadout[] @relation("LoadoutTires")
  loadoutWing      PlayerCarLoadout[] @relation("LoadoutWing")
  loadoutChassis   PlayerCarLoadout[] @relation("LoadoutChassis")

  @@index([category, isActive])
  @@map("racing_car_part")
}

/// Qué arquetipos tiene desbloqueados cada jugador. Separado del equipamiento
/// (`PlayerCarLoadout`): tener uno no implica llevarlo puesto. Vive aparte
/// desde ya aunque hoy todos los arquetipos se concedan por igual, porque la
/// economía de monedas (TASK-286) todavía no ha cerrado en qué se gastan —
/// este es el sitio natural para "comprar" un arquetipo el día que se decida.
model PlayerCarArchetype {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  archetypeId String   @map("archetype_id") @db.Char(36)
  unlockedAt  DateTime @default(now()) @map("unlocked_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  archetype CarArchetype @relation(fields: [archetypeId], references: [id], onDelete: Cascade)

  @@unique([userId, archetypeId])
  @@map("racing_player_car_archetype")
}

/// Qué piezas tiene desbloqueadas cada jugador. Mismo motivo que
/// `PlayerCarArchetype` para separarlo del equipamiento.
model PlayerCarPart {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  partId     String   @map("part_id") @db.Char(36)
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  part CarPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])
  @@map("racing_player_car_part")
}

/// Configuración de coche que un jugador tiene puesta AHORA MISMO. Una fila
/// por jugador (no por circuito ni por intento): es una preferencia global,
/// igual que la cilindrada o el sentido en `GameSettings`.
///
/// Sin fila = configuración por defecto (el primer arquetipo del catálogo,
/// sin piezas) — no hace falta backfill al desplegar esto ni al dar de alta
/// un jugador nuevo, la fila se crea la primera vez que alguien cambia algo.
model PlayerCarLoadout {
  userId        String  @id @map("user_id") @db.Char(36)
  archetypeId   String  @map("archetype_id") @db.Char(36)
  tiresPartId   String? @map("tires_part_id") @db.Char(36)
  wingPartId    String? @map("wing_part_id") @db.Char(36)
  chassisPartId String? @map("chassis_part_id") @db.Char(36)

  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  archetype   CarArchetype @relation(fields: [archetypeId], references: [id])
  tiresPart   CarPart?     @relation("LoadoutTires", fields: [tiresPartId], references: [id])
  wingPart    CarPart?     @relation("LoadoutWing", fields: [wingPartId], references: [id])
  chassisPart CarPart?     @relation("LoadoutChassis", fields: [chassisPartId], references: [id])

  @@map("racing_player_car_loadout")
}

/// Terreno de sección dentro de UN circuito (TASK-270/271), distinto del tema
/// visual del circuito entero (`Track.theme`). Conjunto CERRADO: a diferencia
/// de `CarArchetype`/`CarPart`, estos cuatro tipos están cableados en el
/// dominio (`validateTrackPath`) y en el cliente (`TrackTerrain.gd`), así que
/// esta tabla no tiene create/delete — solo ajustar los factores de los
/// cuatro sin desplegar el juego (TASK-304).
enum RacingTerrainType {
  ASPHALT
  ICE
  MUD
  WATER
}

/// Efecto numérico de cada tipo de terreno de sección. Sembrado con la
/// decisión de partida de TASK-270; `RacingApi.terrain_effects()` en el
/// cliente Godot los trae en cada arranque y cae a sus propios valores por
/// defecto si no hay red.
model RacingTerrainEffect {
  id   String            @id @default(uuid()) @db.Char(36)
  type RacingTerrainType @unique

  /// Multiplicador de agarre. Mismo eje que `Track.grip` y `Vehicle.grip`.
  grip          Float
  /// Si además de perder agarre, frena la velocidad punta mientras se pisa.
  slowsTopSpeed Boolean @map("slows_top_speed")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("racing_terrain_effect")
}

/// Un Grand Prix agrupa varios circuitos en un orden fijo y agrega una
/// clasificación propia (TASK-247): decisión de partida — suma de tiempos,
/// no puntos por posición, porque el resto del juego es puramente
/// contrarreloj y esto reutiliza ese mismo eje sin inventar un concepto de
/// "ganar manga" nuevo.
model RacingGrandPrix {
  id   String @id @default(uuid()) @db.Char(36)
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(120)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stages   RacingGrandPrixStage[]
  attempts RacingGrandPrixAttempt[]

  @@index([isActive])
  @@map("racing_grand_prix")
}

/// Un circuito del Grand Prix y su orden de disputa. Fila propia (no un
/// array de ids en `RacingGrandPrix`) para poder indexar por circuito y
/// para que el orden sea una columna consultable, no una posición dentro
/// de un JSON.
model RacingGrandPrixStage {
  id          String @id @default(uuid()) @db.Char(36)
  grandPrixId String @map("grand_prix_id") @db.Char(36)
  trackId     String @map("track_id") @db.Char(36)
  /// Orden de disputa dentro del Grand Prix, empezando en 0.
  order       Int

  grandPrix RacingGrandPrix @relation(fields: [grandPrixId], references: [id], onDelete: Cascade)
  track     Track           @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([grandPrixId, order])
  @@unique([grandPrixId, trackId])
  @@map("racing_grand_prix_stage")
}

/// TASK-247: se puede abandonar y reanudar. `IN_PROGRESS` es el intento que
/// se retoma la próxima vez que el jugador entra al Grand Prix; al terminar
/// la última manga pasa a `COMPLETED` y `totalDurationMs` queda fijado.
enum RacingGrandPrixAttemptStatus {
  IN_PROGRESS
  COMPLETED
}

/// Un intento de un jugador de correr un Grand Prix entero. Puede haber
/// muchos COMPLETED por (jugador, Grand Prix) — cada uno es una carrera
/// distinta, igual que `LapTime` guarda todos los intentos — pero como
/// mucho uno IN_PROGRESS a la vez, que es el que se reanuda.
model RacingGrandPrixAttempt {
  id          String @id @default(uuid()) @db.Char(36)
  userId      String @map("user_id") @db.Char(36)
  grandPrixId String @map("grand_prix_id") @db.Char(36)

  status          RacingGrandPrixAttemptStatus @default(IN_PROGRESS)
  /// Suma de `RacingGrandPrixStageResult.durationMs`. Nulo mientras está en
  /// curso — se fija al completar la última manga, no se recalcula al vuelo.
  totalDurationMs Int?                         @map("total_duration_ms")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  grandPrix RacingGrandPrix              @relation(fields: [grandPrixId], references: [id], onDelete: Cascade)
  results   RacingGrandPrixStageResult[]

  /// Encontrar el intento en curso a reanudar, por jugador y Grand Prix.
  @@index([userId, grandPrixId, status])
  /// Clasificación agregada: mejor total completado por Grand Prix.
  @@index([grandPrixId, status, totalDurationMs])
  @@map("racing_grand_prix_attempt")
}

/// Resultado de UNA manga (un circuito) dentro de un intento de Grand Prix.
/// Independiente de `LapTime`: una manga de Grand Prix no compite en el
/// leaderboard normal del circuito, son clasificaciones separadas a
/// propósito, igual que un circuito normal y su sentido inverso.
model RacingGrandPrixStageResult {
  id          String   @id @default(uuid()) @db.Char(36)
  attemptId   String   @map("attempt_id") @db.Char(36)
  trackId     String   @map("track_id") @db.Char(36)
  durationMs  Int      @map("duration_ms")
  completedAt DateTime @default(now()) @map("completed_at")

  attempt RacingGrandPrixAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  track   Track                  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([attemptId, trackId])
  @@map("racing_grand_prix_stage_result")
}

/// Papel de un participante dentro de una carrera online (TASK-282): el
/// jugador real, más hasta dos fantasmas rivales — uno ligeramente mejor
/// (objetivo, a alcanzar) y uno ligeramente peor (amenaza, a no dejar pasar).
/// Ninguno de los dos rivales es obligatorio: sin amenaza si nadie va peor,
/// y el objetivo puede ser el propio fantasma si el jugador ya va primero.
enum RacingOnlineRaceParticipantRole {
  PLAYER
  TARGET
  THREAT
}

/// Una tanda de carrera asíncrona completa: el jugador contra hasta dos
/// fantasmas rivales, ya jugada de principio a fin (TASK-283). Distinta de
/// un `LapTime` suelto — esa tabla sigue siendo la fuente de los tiempos y
/// de los propios fantasmas (TASK-219/220/221); esta es el PAQUETE de una
/// carrera concreta con su resultado ya resuelto.
///
/// El emparejamiento en sí (qué dos rivales tocan) lo decide otra tarea
/// (`API: emparejar rivales y armar una carrera`, TASK-284) — aquí solo se
/// registra el resultado de una carrera ya corrida, con los rivales que el
/// cliente ya conocía de antemano.
model RacingOnlineRace {
  id      String @id @default(uuid()) @db.Char(36)
  userId  String @map("user_id") @db.Char(36)
  trackId String @map("track_id") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")

  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  track        Track                         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  participants RacingOnlineRaceParticipant[]

  /// El historial de carreras online de un jugador, más recientes primero.
  @@index([userId, createdAt])
  @@map("racing_online_race")
}

/// El resultado de UNO de los hasta 3 corredores de una `RacingOnlineRace`.
/// `position` y `deltaMs` se calculan UNA VEZ al registrar la carrera y se
/// guardan tal cual — reconstruir un podio pasado no debe recalcular nada
/// (criterio de done de TASK-283), igual que `totalDurationMs` en
/// `RacingGrandPrixAttempt`.
model RacingOnlineRaceParticipant {
  id     String                          @id @default(uuid()) @db.Char(36)
  raceId String                          @map("race_id") @db.Char(36)
  role   RacingOnlineRaceParticipantRole
  /// De quién es este resultado: el propio jugador en el papel PLAYER, o el
  /// rival cuyo fantasma se usó en TARGET/THREAT (puede coincidir con el
  /// jugador si no había rival mejor y se corrió contra su propio récord).
  userId String @map("user_id") @db.Char(36)

  durationMs Int @map("duration_ms")
  /// 1, 2 o 3 — puesto en ESTA carrera, no en el leaderboard general del circuito.
  position   Int
  /// Diferencia contra el ganador de la carrera, en ms. 0 para quien gana.
  deltaMs    Int @map("delta_ms")

  race RacingOnlineRace @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Un mismo rol como mucho una vez por carrera (un solo PLAYER, como mucho
  /// un TARGET, como mucho un THREAT).
  @@unique([raceId, role])
  @@map("racing_online_race_participant")
}

/// El código corto y permanente de un jugador (TASK-222): lo que comparte
/// por fuera (WhatsApp, en persona) para que otro jugador lo añada como
/// amigo. Se genera perezoso, la primera vez que se pide — no en el alta del
/// usuario, para no gastar códigos de jugadores que nunca llegan a usar la
/// parte social.
model RacingFriendCode {
  id     String @id @default(uuid()) @db.Char(36)
  userId String @unique @map("user_id") @db.Char(36)
  /// 8 caracteres, alfabeto sin ambigüedades (sin 0/O/1/I/L) — se puede
  /// compartir de palabra o por texto sin que se confunda una letra con un
  /// número al transcribirlo.
  code   String @unique @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("racing_friend_code")
}

/// Decisión de partida: la amistad es RECÍPROCA, con aceptación — no basta
/// con introducir el código de alguien, la otra persona tiene que aceptar
/// antes de contar como amigos. Una fila por solicitud, no por pareja: así
/// queda historial de si una solicitud se rechazó, en vez de machacarlo.
enum RacingFriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model RacingFriendship {
  id          String                 @id @default(uuid()) @db.Char(36)
  requesterId String                 @map("requester_id") @db.Char(36)
  addresseeId String                 @map("addressee_id") @db.Char(36)
  status      RacingFriendshipStatus @default(PENDING)

  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// Sin `@@unique([requesterId, addresseeId])` a propósito: tras un rechazo
  /// tiene que poder volver a pedirse, y eso es una fila NUEVA, no reescribir
  /// la vieja — el historial de solicitudes queda intacto. Que no haya ya
  /// una solicitud activa (PENDING/ACCEPTED) entre dos jugadores, en
  /// cualquier dirección, lo comprueba el dominio antes de crear la fila.
  @@index([requesterId, status])
  @@index([addresseeId, status])
  @@map("racing_friendship")
}
